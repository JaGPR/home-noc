# /etc/noc/secrets.env  (chmod 600, never commit the real file)
# Pi-hole v6 app passwords: names must match "password_env" in config.json
PIHOLE_A_PASS=
PIHOLE_B_PASS=
# Omada Open API app (client mode)
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
# Proxmox read-only token: user@realm!tokenid=secret (PVEAuditor role)
PVE_TOKEN=
# NOC web login
NOC_ADMIN_USER=admin
NOC_ADMIN_PASS=
# Random 64 hex chars: python3 -c "import secrets;print(secrets.token_hex(32))"
NOC_SESSION_KEY=
