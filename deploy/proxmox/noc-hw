#!/usr/bin/env python3
"""noc-hw: the Proxmox host's fans and RGB lighting, set from the Home NOC (app/hardware.py) over SSH.

The NOC only stores a wanted mode (`noc-hw set ...`). The `noc-hw guard` service applies it
every few seconds, with fail-safes that do not depend on the NOC:
- at hot_c (CPU or GPU) every fan this controls runs at 100 % until both are below hot_c - 10;
- a temperature that cannot be read hands that target's fans back to firmware control (auto);
- when the guard stops or dies (systemd ExecStopPost runs `noc-hw restore`), every fan goes
  back to the board's / GPU's own control.

Targets: board (the motherboard fan headers in config "channels"), gpu (amdgpu fan), and fanN for one
header: its own mode instead of board's ("group" goes back to following board).
Modes: auto (firmware), quiet, balanced, full, manual <pct>. Never below a channel's min_pct.

  noc-hw status                      JSON: temperatures, fans, wanted modes, guard state
  noc-hw set board|gpu|fanN <mode> [pct]
  noc-hw restore                     every fan back to firmware control now
  noc-hw guard                       the enforcing loop (systemd: noc-hw.service)
  noc-hw lights [refresh]            JSON: RGB lighting groups (ram, gpu, board), from OpenRGB
  noc-hw light ram|gpu|board <mode> [RRGGBB]
  noc-hw lights-apply                detect and re-apply the wanted lighting (boot: noc-hw-lights.service)
  noc-hw ssh                         forced command: runs SSH_ORIGINAL_COMMAND if it is one of the above
Config: /etc/noc-hw.json (see DEFAULTS). Install: deploy/proxmox/install-noc-hw.sh

Lighting runs the OpenRGB CLI (/opt/openrgb, the extracted AppImage), one run at a time. Every
change re-applies all wanted groups in one run, then reads the modes back.

ASUS laptops ("kind": "asus"): fans are driven through the firmware's 8-point custom fan curves
(asus_custom_fan_curve hwmon; speeds from the asus hwmon), so the laptop's own controller keeps
following a sensible curve even if the guard stops. quiet / balanced become a curve, full and manual
a flat one, hot a flat 100 %; auto = the factory curve. Target "profile" sets the ASUS platform
profile (quiet / balanced / performance) and is re-applied by the guard if the firmware changes it.
"""
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(os.environ.get("NOC_HW_ROOT", "/"))   # tests point this at a fake sysfs
CONF = ROOT / "etc/noc-hw.json"
VAR = ROOT / "var/lib/noc-hw"
RUN = ROOT / "run/noc-hw"
HWMON = ROOT / "sys/class/hwmon"
OPENRGB = ROOT / "opt/openrgb/AppRun"
PROFILE = ROOT / "sys/firmware/acpi/platform_profile"

DEFAULTS = {
    "kind": "nct",              # nct: desktop board (pwm per header) + amdgpu; asus: ASUS laptop fan curves
    "board_chip": "nct6798",
    "board_temp": None,         # hwmon with the board temperature (default: board_chip)
    # pwm channel -> {name, min_pct}; only these are ever touched
    "channels": {},
    "hot_c": 85,
    "interval_s": 3,
}
MODES = ("auto", "quiet", "balanced", "full", "manual")
TARGETS = ("board", "gpu")
# (temperature C, fan %) points; linear between them, flat outside
CURVES = {
    "quiet": [(40, 25), (55, 30), (65, 45), (75, 70), (82, 100)],
    "balanced": [(40, 35), (55, 45), (65, 60), (75, 80), (82, 100)],
    "full": [(0, 100)],
}
FIRMWARE = {"nct": 5, "amdgpu": 2}   # pwmN_enable when no original was recorded: SmartFan IV / GPU auto
LIGHT_GROUPS = {"DRAM": "ram", "GPU": "gpu", "Motherboard": "board"}   # OpenRGB device type -> group
COLOR = re.compile(r"[0-9A-Fa-f]{6}")


def conf():
    try:
        return {**DEFAULTS, **json.loads(CONF.read_text())}
    except FileNotFoundError:
        return dict(DEFAULTS)


def hwmon(name):
    """The hwmon directory whose name file is `name` (numbers change between boots)."""
    for d in sorted(HWMON.glob("hwmon*")):
        try:
            if (d / "name").read_text().strip() == name:
                return d
        except OSError:
            pass
    return None


def read_int(p):
    try:
        return int(Path(p).read_text().strip())
    except (OSError, ValueError):
        return None


def write(p, v):
    Path(p).write_text(f"{v}\n")


def temps(cfg):
    """{cpu, gpu, board} in C, None when unreadable."""
    out = {"cpu": None, "gpu": None, "board": None}
    core = hwmon("coretemp")
    if core:
        for lab in core.glob("temp*_label"):
            if lab.read_text().strip().startswith("Package id"):
                v = read_int(str(lab).replace("_label", "_input"))
                out["cpu"] = v / 1000 if v is not None else None
    gpu = hwmon("amdgpu")
    if gpu and (v := read_int(gpu / "temp1_input")) is not None:
        out["gpu"] = v / 1000
    board = hwmon(cfg.get("board_temp") or cfg["board_chip"])
    if board and (v := read_int(board / "temp1_input")) is not None:
        out["board"] = v / 1000
    return out


def curve(points, t):
    if t <= points[0][0]:
        return points[0][1]
    for (t0, p0), (t1, p1) in zip(points, points[1:]):
        if t <= t1:
            return round(p0 + (p1 - p0) * (t - t0) / (t1 - t0))
    return points[-1][1]


def wanted_pct(want, t):
    """A target's wanted mode and its temperature -> fan % (None = firmware control)."""
    mode = (want or {}).get("mode", "auto")
    if mode == "auto":
        return None
    if mode == "manual":
        return int(want["pct"])
    if t is None:
        return None             # can't follow a curve without the temperature: firmware takes over
    return curve(CURVES[mode], t)


def decide(wanted, t, hot_was, hot_c):
    """-> ({target: pct or None}, hot). The guard's whole policy, pure for testing.
    A fanN key is in the plan only when that header has its own wanted mode."""
    hot = any(v is not None and v >= hot_c for v in (t["cpu"], t["gpu"])) or (
        hot_was and any(v is not None and v >= hot_c - 10 for v in (t["cpu"], t["gpu"])))
    out = {}
    own = sorted(k for k in wanted if re.fullmatch(r"fan\d+", k))
    for target, temp in [("board", t["cpu"]), ("gpu", t["gpu"])] + [(k, t["cpu"]) for k in own]:
        pct = wanted_pct(wanted.get(target), temp)
        out[target] = 100 if hot and pct is not None else pct
    return out, hot


def board_fans(cfg):
    d = hwmon(cfg["board_chip"])
    return [(d, ch, c) for ch, c in sorted(cfg["channels"].items(), key=lambda x: int(x[0]))] if d else []


def gpu_fan():
    d = hwmon("amdgpu")
    return d if d and (d / "pwm1").exists() else None


def originals():
    try:
        return json.loads((VAR / "orig.json").read_text())
    except (OSError, ValueError):
        return {}


def take(enable_path, kind):
    """Switch one fan to manual, remembering its firmware mode the first time."""
    orig = originals()
    cur = read_int(enable_path)
    if str(enable_path) not in orig and cur not in (None, 1):
        orig[str(enable_path)] = cur
        VAR.mkdir(parents=True, exist_ok=True)
        (VAR / "orig.json").write_text(json.dumps(orig))
    if cur != 1:
        write(enable_path, 1)


def release(enable_path, kind):
    v = originals().get(str(enable_path), FIRMWARE[kind])
    if read_int(enable_path) != v:
        write(enable_path, v)


def apply(cfg, plan):
    """Write the decided % (or hand back to firmware) for each target's fans."""
    for d, ch, c in board_fans(cfg):
        en, pwm = d / f"pwm{ch}_enable", d / f"pwm{ch}"
        pct = plan[f"fan{ch}"] if f"fan{ch}" in plan else plan.get("board")
        if pct is None:
            release(en, "nct")
        else:
            take(en, "nct")
            value = round(max(pct, int(c.get("min_pct", 25))) * 255 / 100)
            if read_int(pwm) != value:
                write(pwm, value)
    g = gpu_fan()
    if g:
        pct = plan.get("gpu")
        if pct is None:
            release(g / "pwm1_enable", "amdgpu")
        else:
            take(g / "pwm1_enable", "amdgpu")
            value = round(max(pct, int(cfg.get("gpu_min_pct", 20))) * 255 / 100)
            if read_int(g / "pwm1") != value:
                write(g / "pwm1", value)


def restore(cfg=None):
    cfg = cfg or conf()
    if cfg.get("kind") == "asus":
        asus_apply(cfg, {}, False)
    else:
        apply(cfg, {"board": None, "gpu": None})


# ---------------------------------------------------------------- ASUS laptops (kind "asus")
ASUS_TEMPS = (40, 50, 58, 64, 70, 75, 80, 85)   # the 8 curve points' temperatures, C
ASUS_CUSTOM, ASUS_FACTORY = 1, 2                # asus_custom_fan_curve pwmN_enable values


def asus_points(want, hot, min_pct):
    """A fan's wanted mode -> its 8 (temp C, pwm 0-255) curve points; None = the factory curve.
    Points never fall below min_pct; hot (and full) is a flat 100 %."""
    mode = (want or {}).get("mode", "auto")
    if mode == "auto":
        return None
    if hot or mode == "full":
        pcts = [100] * 8
    elif mode == "manual":
        pcts = [int(want["pct"])] * 8
    else:
        pcts = [curve(CURVES[mode], t) for t in ASUS_TEMPS]
    return [(t, round(max(p, min_pct) * 255 / 100)) for t, p in zip(ASUS_TEMPS, pcts)]


def asus_read_points(d, ch):
    return [(read_int(d / f"pwm{ch}_auto_point{i}_temp"), read_int(d / f"pwm{ch}_auto_point{i}_pwm")) for i in range(1, 9)]


def asus_want(wanted, ch):
    return wanted.get(f"fan{ch}") or wanted.get("board")


def asus_apply(cfg, wanted, hot):
    """Write each channel's curve and switch it on, or hand it back to the factory curve. A curve is only
    rewritten when it differs (the firmware takes all 8 points again when the curve is switched on)."""
    d = hwmon("asus_custom_fan_curve")
    if not d:
        raise RuntimeError("no asus_custom_fan_curve hwmon (asus-wmi)")
    for ch, c in sorted(cfg["channels"].items(), key=lambda x: int(x[0])):
        en = d / f"pwm{ch}_enable"
        pts = asus_points(asus_want(wanted, ch), hot, int(c.get("min_pct", 25)))
        if pts is None:
            if read_int(en) != ASUS_FACTORY:
                write(en, ASUS_FACTORY)
        elif read_int(en) != ASUS_CUSTOM or asus_read_points(d, ch) != pts:
            for i, (t, p) in enumerate(pts, 1):
                write(d / f"pwm{ch}_auto_point{i}_temp", t)
                write(d / f"pwm{ch}_auto_point{i}_pwm", p)
            write(en, ASUS_CUSTOM)
    prof = wanted.get("profile")
    if prof and PROFILE.exists() and PROFILE.read_text().strip() != prof["mode"]:
        write(PROFILE, prof["mode"])


def profiles():
    try:
        return (ROOT / "sys/firmware/acpi/platform_profile_choices").read_text().split()
    except OSError:
        return []


def asus_status(cfg, t):
    """Fans of an ASUS laptop: rpm from the asus hwmon, % = our curve at the current CPU temperature.
    On the factory curve % is None: the firmware does not follow the factory points it reports."""
    fans, d, rpm = [], hwmon("asus_custom_fan_curve"), hwmon("asus")
    for ch, c in sorted(cfg["channels"].items(), key=lambda x: int(x[0])):
        auto = not d or read_int(d / f"pwm{ch}_enable") != ASUS_CUSTOM
        pts = [] if auto else [(tc, round(p * 100 / 255)) for tc, p in asus_read_points(d, ch) if tc is not None and p is not None]
        fans.append({"target": "board", "channel": int(ch), "id": f"fan{ch}", "name": c.get("name", f"Fan {ch}"),
                     "rpm": read_int(rpm / f"fan{ch}_input") if rpm else None,
                     "pct": curve(pts, t["cpu"]) if pts and t["cpu"] is not None else None,
                     "auto": auto, "min_pct": int(c.get("min_pct", 25))})
    return fans


def load_wanted():
    try:
        return json.loads((VAR / "wanted.json").read_text())
    except (OSError, ValueError):
        return {}


def targets(cfg):
    """What `set` accepts besides fanN on this host."""
    return ("board", "profile") if cfg.get("kind") == "asus" else TARGETS


def set_mode(target, mode, pct=None, cfg=None):
    cfg = cfg or conf()
    channel = target[3:] if re.fullmatch(r"fan\d+", str(target)) else None
    if channel is not None and channel not in cfg["channels"]:
        raise ValueError(f"{target} is not a controlled fan header")
    if target not in targets(cfg) and channel is None:
        raise ValueError(f"target must be one of {', '.join(targets(cfg))} or fanN")
    if target == "profile":
        if mode not in profiles():
            raise ValueError(f"profile must be one of {', '.join(profiles()) or '(none: no platform_profile)'}")
        w = load_wanted()
        w["profile"] = {"mode": mode}
        save_wanted(w)
        return w
    if channel is not None and mode == "group":   # follow the board setting again
        w = load_wanted()
        w.pop(target, None)
        save_wanted(w)
        return w
    if mode not in MODES:
        raise ValueError(f"mode must be one of {', '.join(MODES)}" + (" or group" if channel else ""))
    entry = {"mode": mode}
    if mode == "manual":
        try:
            pct = int(pct)
        except (TypeError, ValueError):
            raise ValueError("manual needs a fan % (0-100)")
        if not 0 <= pct <= 100:
            raise ValueError("fan % must be 0-100")
        entry["pct"] = pct
    w = load_wanted()
    w[target] = entry
    save_wanted(w)
    return w


def save_wanted(w):
    VAR.mkdir(parents=True, exist_ok=True)
    tmp = VAR / "wanted.json.new"
    tmp.write_text(json.dumps(w))
    tmp.replace(VAR / "wanted.json")


def status(cfg=None):
    cfg = cfg or conf()
    t, fans = temps(cfg), []
    if cfg.get("kind") == "asus":
        fans = asus_status(cfg, t)
    for d, ch, c in board_fans(cfg) if cfg.get("kind") != "asus" else []:
        fans.append({"target": "board", "channel": int(ch), "id": f"fan{ch}", "name": c.get("name", f"Fan {ch}"),
                     "rpm": read_int(d / f"fan{ch}_input"), "pct": round((read_int(d / f"pwm{ch}") or 0) * 100 / 255),
                     "auto": read_int(d / f"pwm{ch}_enable") != 1, "min_pct": int(c.get("min_pct", 25))})
    g = gpu_fan() if cfg.get("kind") != "asus" else None
    if g:
        fans.append({"target": "gpu", "channel": 1, "name": "GPU fan", "rpm": read_int(g / "fan1_input"),
                     "pct": round((read_int(g / "pwm1") or 0) * 100 / 255), "auto": read_int(g / "pwm1_enable") != 1,
                     "min_pct": int(cfg.get("gpu_min_pct", 20))})
    try:
        guard = json.loads((RUN / "guard.json").read_text())
        guard["age_s"] = round(time.time() - guard.pop("ts"), 1)
        guard["running"] = guard["age_s"] < 4 * cfg["interval_s"]
    except (OSError, ValueError, KeyError):
        guard = {"running": False}
    out = {"temps": t, "fans": fans, "wanted": load_wanted(), "guard": guard, "kind": cfg.get("kind", "nct"),
           "targets": [x for x in targets(cfg) if x != "gpu" or g], "hot_c": cfg["hot_c"], "modes": list(MODES),
           "lights": lights(may_detect=False)}
    if cfg.get("kind") == "asus":
        out["profile"] = {"current": PROFILE.read_text().strip() if PROFILE.exists() else None, "choices": profiles()}
    return out


def parse_devices(text):
    """OpenRGB `--list-detailed` output -> [{index, name, type, location, modes, mode, zones, leds}]."""
    devs, cur = [], None
    for line in text.splitlines():
        if m := re.match(r"(\d+): (.+)$", line):
            cur = {"index": int(m[1]), "name": m[2].strip(), "type": "", "location": "", "modes": [], "mode": None,
                   "zones": [], "leds": 0}
            devs.append(cur)
        elif cur and (m := re.match(r"\s+(Type|Location|Modes|Zones|LEDs):\s*(.*)$", line)):
            key, val = m[1], m[2].strip()
            if key in ("Type", "Location"):
                cur[key.lower()] = val
                continue
            try:
                items = shlex.split(val)
            except ValueError:
                items = val.split()
            if key == "LEDs":
                cur["leds"] = len(items)
            elif key == "Zones":
                cur["zones"] = items
            else:
                for it in items:
                    if it.startswith("[") and it.endswith("]"):   # [Rainbow]: the active mode
                        it = cur["mode"] = it[1:-1]
                    cur["modes"].append(it)
    return devs


def run_openrgb(args, timeout=60):
    """One OpenRGB CLI run (headless), never two at once: they share the SMBus and USB devices."""
    import fcntl   # Linux only; the rest of this file is tested on any OS
    (VAR / "openrgb").mkdir(parents=True, exist_ok=True)
    RUN.mkdir(parents=True, exist_ok=True)
    with open(RUN / "openrgb.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        r = subprocess.run([str(OPENRGB), "--noautoconnect", "--config", str(VAR / "openrgb"), *args],
                           cwd=str(VAR), env={**os.environ, "QT_QPA_PLATFORM": "offscreen"},
                           capture_output=True, text=True, timeout=timeout)
    if r.returncode:
        raise ValueError(f"OpenRGB failed ({r.returncode}): {(r.stderr or r.stdout).strip()[-200:]}")
    return r.stdout


def detect():
    """Detect the devices now and cache them (RUN/lights.json)."""
    devs = [d for d in parse_devices(run_openrgb(["--list-detailed"])) if d["type"] in LIGHT_GROUPS]
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / "lights.json").write_text(json.dumps({"ts": time.time(), "devices": devs}))
    return devs


def cached_devices():
    try:
        return json.loads((RUN / "lights.json").read_text())["devices"]
    except (OSError, ValueError, KeyError):
        return None


def load_lights_wanted():
    try:
        return json.loads((VAR / "lights.json").read_text())
    except (OSError, ValueError):
        return {}


def groups(devs, wanted=None):
    """Devices -> {group: {devices, modes (shared by all its devices, without Direct), mode, wanted}}."""
    out = {}
    for d in devs:
        g = out.setdefault(LIGHT_GROUPS[d["type"]], {"devices": [], "modes": None})
        g["devices"].append({"name": d["name"], "mode": d["mode"], "leds": d["leds"], "zones": d["zones"]})
        g["modes"] = [m for m in (d["modes"] if g["modes"] is None else g["modes"]) if m in d["modes"] and m != "Direct"]
    for name, g in out.items():
        now = {d["mode"] for d in g["devices"]}
        g["mode"] = now.pop() if len(now) == 1 else None
        g["wanted"] = (wanted or {}).get(name)
    return out


def lights(refresh=False, may_detect=True):
    """{available, groups}; detects when asked (refresh), or when nothing is cached yet and may_detect."""
    if not OPENRGB.exists():
        return {"available": False, "groups": {}}
    devs = cached_devices()
    if refresh or (devs is None and may_detect):
        devs = detect()
    return {"available": True, "groups": groups(devs or [], load_lights_wanted()), "detected": devs is not None}


def light_args(devs, wanted):
    """The one OpenRGB command line that applies every wanted group."""
    args = []
    for d in devs:
        w = wanted.get(LIGHT_GROUPS.get(d["type"]))
        if w:
            args += ["--device", str(d["index"]), "--mode", w["mode"]] + (["--color", w["color"]] if w.get("color") else [])
    return args


def verify(devs, wanted):
    """{group: True (read back as set) / False / None (the device does not report its mode)}."""
    out = {}
    for name, g in groups(devs).items():
        if name in wanted:
            modes = {d["mode"] for d in g["devices"]}
            out[name] = None if modes <= {"Direct", None} else modes == {wanted[name]["mode"]}
    return out


def apply_lights(devs, wanted):
    if not (args := light_args(devs, wanted)):
        return {}
    run_openrgb(args)
    return verify(detect(), wanted)


def set_light(group, mode, color=None):
    devs = cached_devices()
    if devs is None:
        devs = detect()
    g = groups(devs).get(group)
    if not g:
        raise ValueError(f"no {group} lighting found (have: {', '.join(groups(devs)) or 'none'})")
    match = [m for m in g["modes"] if m.lower() == str(mode).lower()]
    if not match:
        raise ValueError(f"{group} modes: {', '.join(g['modes'])}")
    entry = {"mode": match[0]}
    if color:
        if not COLOR.fullmatch(str(color)):
            raise ValueError("colour must be 6 hex digits (RRGGBB)")
        entry["color"] = str(color).upper()
    w = load_lights_wanted()
    w[group] = entry
    VAR.mkdir(parents=True, exist_ok=True)
    tmp = VAR / "lights.json.new"
    tmp.write_text(json.dumps(w))
    tmp.replace(VAR / "lights.json")
    res = apply_lights(devs, w)
    if res.get(group) is False:
        raise ValueError(f"{group} did not read back as {entry['mode']}")
    return {"group": group, "set": entry, "verified": res.get(group), "lights": lights(may_detect=False)}


def tick(cfg, hot):
    """One guard pass: decide and apply, or on any error hand every fan back. -> hot."""
    err = None
    try:
        wanted = load_wanted()
        plan, hot = decide(wanted, temps(cfg), hot, cfg["hot_c"])
        if cfg.get("kind") == "asus":
            asus_apply(cfg, wanted, hot)   # the firmware follows the curve; plan is what the guard reports
        else:
            apply(cfg, plan)
    except Exception as ex:   # never leave fans in manual on an error
        err, plan = f"{type(ex).__name__}: {ex}", {}
        try:
            restore(cfg)
        except Exception:
            pass
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / "guard.json").write_text(json.dumps({"ts": time.time(), "hot": hot, "applied": plan, "error": err}))
    return hot


def guard():
    cfg, hot, stop = conf(), False, False

    def on_term(*_):
        nonlocal stop
        stop = True
    signal.signal(signal.SIGTERM, on_term)
    while not stop:
        hot = tick(cfg, hot)
        time.sleep(cfg["interval_s"])
    restore(cfg)


def main(argv):
    if argv[:1] == ["ssh"]:   # forced command: only this program's own commands
        argv = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
        if argv and argv[0] in ("noc-hw", "/usr/local/sbin/noc-hw"):   # the same command line works with a plain key
            argv = argv[1:]
        if argv[:1] in (["guard"], ["ssh"]):
            argv = []
    cmd = argv[0] if argv else ""
    try:
        if cmd == "status":
            print(json.dumps(status()))
        elif cmd == "set" and len(argv) in (3, 4):
            set_mode(argv[1], argv[2], argv[3] if len(argv) == 4 else None)
            print(json.dumps(status()))
        elif cmd == "restore":
            restore()
            print(json.dumps({"restored": True}))
        elif cmd == "lights" and argv[1:] in ([], ["refresh"]):
            print(json.dumps(lights(refresh=argv[1:] == ["refresh"])))
        elif cmd == "light" and len(argv) in (3, 4):
            print(json.dumps(set_light(argv[1], argv[2], argv[3] if len(argv) == 4 else None)))
        elif cmd == "lights-apply":
            w = load_lights_wanted()
            print(json.dumps({"verified": apply_lights(detect(), w) if OPENRGB.exists() else {}}))
        elif cmd == "guard":
            guard()
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except (ValueError, subprocess.TimeoutExpired) as ex:
        print(json.dumps({"error": str(ex)}))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
