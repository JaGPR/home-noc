[Unit]
Description=Home NOC command center
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/noc
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8080 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
