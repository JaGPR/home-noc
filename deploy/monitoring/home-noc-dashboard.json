{
 "uid": "home-noc",
 "title": "Home NOC",
 "tags": [
  "home-noc"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "editable": true,
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "isp",
    "label": "ISP",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "noc-prom"
    },
    "query": "label_values(noc_wan_up, isp)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Right now",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Download now",
   "datasource": {
    "type": "prometheus",
    "uid": "noc-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "noc-prom"
     },
     "refId": "A",
     "expr": "sum(noc_wan_rate_bits{direction=\"down\",isp=~\"$isp\"})",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Upload now",
   "datasource": {
    "type": "prometheus",
    "uid": "noc-prom"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "noc-prom"
     },
     "refId": "A",
     "expr": "sum(noc_wan_rate_bits{direction=\"up\",isp=~\"$isp\"})",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Data used this month",
   "datasource": {
    "type": "prometheus",
    "uid": "noc-prom"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "noc-prom"
     },
     "refId": "A",
     "expr": "sum(noc_wan_month_bytes{isp=~\"$isp\"})",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "stat",
   "title": "WANs up",
   "datasource": {
    "type": "prometheus",
    "uid": "noc-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "noc-prom"
     },
     "refId": "A",
     "expr": "sum(noc_wan_up{isp=~\"$isp\"})",
     "legendFormat": "up"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "noc-prom"
     },
     "refId": "B",
     "expr": "count(noc_wan_up{isp=~\"$isp\"})",
     "legendFormat": "of"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "textMode": "value_and_name",
    "colorMode": "none"
   }
  },
  {
   "id": 6,
   "type": "state-timeline",
   "title": "WAN up / down",
   "datasource": {
    "type": "prometheus",
    "uid": "noc-prom"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "noc-prom"
     },
     "refId": "A",
     "expr": "noc_wan_up{isp=~\"$isp\"}",
     "legendFormat": "{{wan}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down",
         "color": "red"
        },
        "1": {
         "text": "up",
         "color": "green"
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Download per WAN",
   "datasource": {
    "type": "prometheus",
    "uid": "noc-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "noc-prom"
     },
     "refId": "A",
     "expr": "noc_wan_rate_bits{direction=\"down\",isp=~\"$isp\"}",
     "legendFormat": "{{wan}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "fillOpacity": 25,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Upload per WAN",
   "datasource": {
    "type": "prometheus",
