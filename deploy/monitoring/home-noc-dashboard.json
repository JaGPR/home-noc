   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "noc-prom"
     },
     "refId": "A",
     "expr": "sum by (isp) (increase(noc_wan_bytes_total{isp=~\"$isp\"}[1d]))",
     "legendFormat": "{{isp}}",
     "interval": "1d"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {}
