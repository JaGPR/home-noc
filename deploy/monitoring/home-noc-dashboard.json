   "type": "row",
   "title": "Data used",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 10,
   "type": "bargauge",
   "title": "This month per ISP",
   "datasource": {
    "type": "prometheus",
    "uid": "noc-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "noc-prom"
     },
     "refId": "A",
     "expr": "sum by (isp) (noc_wan_month_bytes{isp=~\"$isp\"})",
     "legendFormat": "{{isp}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true
   }
  },
  {
