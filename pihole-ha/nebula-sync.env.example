# /etc/nebula-sync.env on the REPLICA (chmod 600, root only).
# Copies blocklists, allow/deny rules, groups, clients and local DNS records
# from the primary to the replica. Web server settings (ports) are NOT synced.
#
# Use the primary's DIRECT address, not the VIP: after a failover the VIP points at
# the replica itself. Passwords are Pi-hole v6 *app passwords*
# (Settings > Web interface / API > Configure app password).
PRIMARY=http://192.0.2.11|PRIMARY_APP_PASSWORD
REPLICAS=http://127.0.0.1:8080|REPLICA_APP_PASSWORD

FULL_SYNC=false
# Gravity is rebuilt nightly by cron instead (heavy on a Raspberry Pi).
RUN_GRAVITY=false
CRON="*/30 * * * *"
TZ=UTC

SYNC_CONFIG_DNS=true
SYNC_CONFIG_DNS_EXCLUDE=interface,port

SYNC_GRAVITY_GROUP=true
SYNC_GRAVITY_AD_LIST=true
SYNC_GRAVITY_AD_LIST_BY_GROUP=true
SYNC_GRAVITY_DOMAIN_LIST=true
SYNC_GRAVITY_DOMAIN_LIST_BY_GROUP=true
SYNC_GRAVITY_CLIENT=true
SYNC_GRAVITY_CLIENT_BY_GROUP=true
